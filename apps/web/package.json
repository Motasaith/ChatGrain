{
  "name": "@docent/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker,voice -c green,cyan,magenta \"next dev\" \"tsx watch src/worker-entry.ts\" \"tsx watch --tsconfig tsconfig.voice.json src/voice-entry.ts\"",
    "dev:web": "next dev",
    "worker": "tsx src/worker-entry.ts",
    "voice": "tsx --tsconfig tsconfig.voice.json src/voice-entry.ts",
    "site-agent:sync": "tsx scripts/sync-homepage-agent.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push --force",
    "test": "vitest run",
    "diagnose:crawl": "tsx --tsconfig tsconfig.voice.json scripts/diagnose-crawl.ts",
    "diagnose:answer": "tsx --tsconfig tsconfig.voice.json scripts/diagnose-answer.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.2",
    "@huggingface/transformers": "^4.2.0",
    "@mozilla/readability": "^0.6.0",
    "@next/env": "16.2.12",
    "@sentry/nextjs": "^10.68.0",
    "@sentry/node": "^10.68.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "entities": "^6.0.1",
    "exceljs": "^4.4.0",
    "jose": "^6.2.4",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.27.0",
    "nanoid": "^6.0.0",
    "next": "16.2.12",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "playwright-core": "1.62.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tough-cookie": "6.0.2",
    "unpdf": "^1.8.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-pgvector": "^0.0.5",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3"
  }
}
