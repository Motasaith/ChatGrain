LLM_PROVIDERS=groq,ollama

LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_GROQ_MODEL=
LLM_GROQ_API_KEY=
# LLM_GROQ_MODEL_2=llama-3.1-8b-instant
# LLM_GROQ_API_KEY_2=gsk_second
# LLM_GROQ_API_KEY_3=gsk_third

LLM_OLLAMA_BASE_URL=https://ollama.com/v1
LLM_OLLAMA_MODEL=
LLM_OLLAMA_API_KEY=
# LLM_OLLAMA_API_KEY_2=...

SECRET_ENCRYPTION_KEY=replace_with_a_secure_random_string

# Clerk
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Clerk & Sentry 
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
AUTH_PROVIDER=clerk
# Comma separated. These accounts get administrator rights, so keep the real
# list in .env only - a committed allowlist names the accounts worth attacking.
ADMIN_EMAILS=
INACTIVE_USER_RETENTION_DAYS=30
RETENTION_SCAN_INTERVAL_HOURS=24
RETENTION_DELETE_CLERK_USERS=false
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_PROJECT=javascript-nextjs
SENTRY_API_BASE_URL=https://de.sentry.io
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SYSTEM_LOG_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=180
ADMIN_FILE_MAX_BYTES=26214400
USER_CRAWL_MAX_PAGES=10000
ADMIN_CRAWL_MAX_PAGES=10000

# Realtime voice calls. Speech to text is Groq (any OpenAI-compatible
# endpoint works); text to speech is a local Kokoro-FastAPI server on 8880.
# WHISPER_MODEL_NAME must be set for any OpenAI-compatible provider - it is
# what tells the client this is not a whisper.cpp server.
# The WebSocket gateway is a separate Node process (npm run voice); npm run dev
# starts it automatically alongside the web app and crawl worker.
WHISPER_BASE_URL=https://api.groq.com/openai/v1
WHISPER_TRANSCRIBE_PATH=/audio/transcriptions
# TTS_BASE_URL=   # only when TTS_PROVIDER=http
TTS_VOICE=af_bella
TTS_SAMPLE_RATE=24000
VOICE_ENABLED=true
VOICE_WS_PORT=3002
NEXT_PUBLIC_VOICE_WS_PORT=3002

# Sentry issue reading (optional)
SENTRY_AUTH_TOKEN=

# Ticket reply email (optional)
SUPPORT_EMAIL_PROVIDER=
SMTP_URL=
RESEND_API_KEY=
SUPPORT_EMAIL_FROM=

# Worker and crawler.
#
# WORKER_HEARTBEAT_MS is load-bearing beyond logging: a job whose worker misses
# six beats is treated as abandoned and handed to another worker, so raising
# this lengthens how long a dead worker holds its job.
WORKER_POLL_MS=1500
WORKER_HEARTBEAT_MS=5000
# Pages held in memory before a batch is committed. This is the memory control
# for the crawl - a page limit is not one, because a thousand short pages and a
# thousand long ones cost very different amounts to hold. Smaller batches mean
# lower peak memory and less work lost to a crash, at the cost of more
# transactions.
CRAWL_BATCH_PAGES=25
CRAWL_CONCURRENCY=6
CRAWL_TIMEOUT_MS=15000
CRAWL_MAX_BYTES=5000000
CRAWL_RENDER_TIMEOUT_MS=10000
CRAWL_RENDER_CONCURRENCY=3
USER_FILE_MAX_BYTES=26214400
BROWSER_EXECUTABLE_PATH=
BROWSER_DISABLE_SANDBOX=false

# Model overrides
VISION_LLM_MODEL=
# INTENT_LLM_MODEL=
# LLM_GROQ_API_KEY_2=

# Attachments and speech
UPLOAD_DIR=.data/uploads
WHISPER_API_KEY=
WHISPER_MODEL_NAME=whisper-large-v3-turbo
# TTS_SPEED=1
# TTS_API_KEY=
# NEXT_PUBLIC_VOICE_WS_URL=

# Web
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# DOCENT_PUBLIC_URL=http://localhost:3000
# DOCENT_SITE_URL=http://localhost:3000
# DOCENT_SITE_REFRESH_HOURS=1
# DOCENT_SITE_PAGE_LIMIT=250
# DOCENT_SITE_AGENT_ID=
# Hosted Postgres with pgvector. Run `CREATE EXTENSION vector;` once.
DATABASE_URL=
# Connections are per process and three processes share the database (web,
# worker, voice). Hosted plans cap the total far lower than a container does.
DATABASE_POOL_MAX=5
# LOG_LEVEL=info
WIDGET_SIGNING_SECRET=replace_with_a_secure_random_string

# Dev-only identity, used when AUTH_PROVIDER=dev
# DEV_USER_ID=dev_local_owner
# DEV_USER_EMAIL=owner@docent.local
# DEV_USER_NAME=Local Owner

# Object storage for chat attachments. Leave S3_BUCKET empty to keep writing to
# UPLOAD_DIR on local disk. Any S3-compatible service works - Backblaze B2,
# Cloudflare R2, Supabase Storage - only the endpoint and region differ.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Embeddings.
#
# EMBEDDING_PROVIDER picks the backend:
#   cloudflare - Workers AI, serving the same Qwen3-Embedding-0.6B this repo
#                runs locally. Needs CLOUDFLARE_ACCOUNT_ID and
#                CLOUDFLARE_API_TOKEN below. Recommended for anything deployed.
#   openai     - any OpenAI-compatible /v1/embeddings service (OpenRouter,
#                Deepinfra, SiliconFlow, Gemini's compatibility layer). Needs
#                EMBEDDING_BASE_URL, EMBEDDING_API_KEY and EMBEDDING_MODEL_ID.
#   local      - transformers.js inside the worker process. No API cost and no
#                network dependency, but measured at roughly 2.8 GB of resident
#                memory before a single page is fetched - and that floor is the
#                same for a 12-page site as for a 3,400-page one, because it is
#                the model, not the crawl. A 2 GB host cannot run it. Treat it
#                as a development convenience or a large-machine option.
#   hash       - deterministic nonsense vectors. Tests only.
EMBEDDING_PROVIDER=cloudflare

# Workers AI. The token needs the Workers AI read permission and nothing else.
# Read only when EMBEDDING_PROVIDER=cloudflare.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Read by the cloudflare and openai providers only. Setting this alone does not
# change which model runs on this machine - EMBEDDING_MODEL below does that.
EMBEDDING_MODEL_ID=@cf/qwen/qwen3-embedding-0.6b

# For EMBEDDING_PROVIDER=openai.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# For EMBEDDING_PROVIDER=local. Qwen3-Embedding needs last_token pooling; mean
# pooling returns a plausible but degraded vector rather than an error, so the
# model name and the pooling default have to agree - this is not a preference.
EMBEDDING_MODEL=onnx-community/Qwen3-Embedding-0.6B-ONNX
MODEL_CACHE_DIR=.cache/models
# q8 is the floor worth using for retrieval. q4 is a 4-bit model that still
# returns a plausible unit vector, so its cost arrives as quietly worse answers
# rather than an error anyone would notice.
EMBEDDING_DTYPE=q8
# EMBEDDING_POOLING=   # override only; defaults follow the model family

# Native width is 1024, truncated to this via Matryoshka to fit
# chunks.embedding. Must match the schema. Changing the model, the width or the
# provider invalidates every stored vector, so re-index every source after
# touching any of them.
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH=64
# Some model families expect asymmetric prefixes on queries and documents.
# Defaults follow the family; set these only to override it.
# EMBEDDING_QUERY_PREFIX=
# EMBEDDING_DOCUMENT_PREFIX=
# EMBEDDING_RETRY_BASE_MS=500

# Text to speech for voice calls. The local provider loads Kokoro in the voice
# process; it takes about 12 seconds to come up from cold, which is why the
# gateway starts loading it the moment a call connects rather than when the
# first answer needs speaking.
TTS_PROVIDER=local
TTS_MODEL_ID=onnx-community/Kokoro-82M-v1.0-ONNX
TTS_DTYPE=q8
