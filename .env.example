# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgres://docent:docent@127.0.0.1:5434/docent
LOG_LEVEL=info
WIDGET_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Local identity adapter. Explicitly opt in for private/self-hosted installs.
AUTH_PROVIDER=dev
DEV_USER_ID=dev_local_owner
DEV_USER_EMAIL=owner@docent.local
DEV_USER_NAME=Local Owner

# Embeddings. "local" downloads the model once and caches it on disk.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
MODEL_CACHE_DIR=.cache/models

# Optional local generative answers. Leave OLLAMA_MODEL blank for extractive mode.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Worker and crawler bounds
WORKER_POLL_MS=1500
CRAWL_CONCURRENCY=6
CRAWL_TIMEOUT_MS=15000
CRAWL_MAX_BYTES=5000000

# Optional hosted adapters
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
