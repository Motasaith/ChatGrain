# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
# The worker creates and maintains a first-party homepage support agent from
# this URL. It refreshes on worker startup and at the interval below.
DOCENT_SITE_URL=http://localhost:3000
DOCENT_SITE_REFRESH_HOURS=1
DOCENT_SITE_PAGE_LIMIT=250
# Optional override: use an existing agent instead of the managed site agent.
DOCENT_SITE_AGENT_ID=
DATABASE_URL=postgres://docent:docent@127.0.0.1:5434/docent
LOG_LEVEL=info
WIDGET_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Authentication. Clerk is the production default; use "dev" only for a
# private local installation without public access.
AUTH_PROVIDER=clerk
ADMIN_EMAILS=abdulraufazhardev@gmail.com,binacodex@gmail.com
DEV_USER_ID=dev_local_owner
DEV_USER_EMAIL=owner@docent.local
DEV_USER_NAME=Local Owner

# Embeddings. "local" downloads the model once and caches it on disk.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
MODEL_CACHE_DIR=.cache/models

# Grounded generation. Ollama Cloud is the default OpenAI-compatible endpoint.
# Create a key at ollama.com, keep it only in .env.local, and never commit it.
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
LLM_MODEL=gemma4:31b
VISION_LLM_MODEL=gemma4:31b
# Optional: use a smaller, fast multilingual model for pre-retrieval intent routing.
INTENT_LLM_MODEL=

# Widget attachments and free self-hosted voice transcription. Images are sent
# to VISION_LLM_MODEL. Audio stays playable in conversation history; when a
# Whisper endpoint is configured its transcript is sent to the text model.
UPLOAD_DIR=.data/uploads
WHISPER_BASE_URL=http://127.0.0.1:8080
WHISPER_TRANSCRIBE_PATH=/inference
WHISPER_API_KEY=

# Realtime voice calls (speech in, speech out) run in their own process so the
# WebSocket is not bound by Next.js request lifetimes. Start it with
# `npm run voice`; `npm run dev` already includes it.
# Requires WHISPER_BASE_URL above for speech recognition and TTS_BASE_URL below
# for the spoken reply. Without either, calls degrade to a typed fallback.
VOICE_ENABLED=true
VOICE_WS_PORT=3002
# Where the browser should reach the gateway. Leave the URL blank in local
# development to derive ws://<current-host>:VOICE_WS_PORT/voice automatically.
# Behind TLS, terminate wss:// at your proxy and set the full URL here.
NEXT_PUBLIC_VOICE_WS_PORT=3002
NEXT_PUBLIC_VOICE_WS_URL=

# Self-hosted speech synthesis on an OpenAI-compatible /v1/audio/speech route.
# `docker compose --profile voice up -d` starts a Piper-backed server here.
TTS_BASE_URL=http://127.0.0.1:8001/v1
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_SPEED=1
TTS_SAMPLE_RATE=22050
TTS_API_KEY=

# Whisper model used by the compose `voice` profile. Larger is more accurate
# and slower; base-q5_1 keeps call latency usable on CPU.
WHISPER_MODEL=base-q5_1
WHISPER_THREADS=4

# Worker and crawler bounds
WORKER_POLL_MS=1500
WORKER_HEARTBEAT_MS=5000
CRAWL_CONCURRENCY=6
CRAWL_TIMEOUT_MS=15000
CRAWL_MAX_BYTES=5000000
CRAWL_RENDER_TIMEOUT_MS=10000
CRAWL_RENDER_CONCURRENCY=3
# Community users keep conservative resource limits. Administrators can crawl
# a whole normal website and have no Docent-level upload cap by default.
# Set ADMIN_FILE_MAX_BYTES to a positive byte count to enforce a production cap.
USER_FILE_MAX_BYTES=5242880
ADMIN_FILE_MAX_BYTES=0
USER_CRAWL_MAX_PAGES=500
ADMIN_CRAWL_MAX_PAGES=10000
# Optional when Chrome/Chromium is not installed in a standard location.
BROWSER_EXECUTABLE_PATH=
# Only use this in a container that cannot enable the Chromium sandbox.
BROWSER_DISABLE_SANDBOX=false

# Inactive accounts are removed from Docent after the retention window.
# Clerk identity deletion is irreversible and therefore opt-in.
INACTIVE_USER_RETENTION_DAYS=30
RETENTION_SCAN_INTERVAL_HOURS=24
RETENTION_DELETE_CLERK_USERS=false
SYSTEM_LOG_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=180

# Clerk (written automatically by `clerk init` for local development)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Sentry ingestion. The API token is optional and is only needed to display
# Sentry issues inside Docent's administrator dashboard.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=bina-codes
SENTRY_PROJECT=javascript-nextjs
SENTRY_API_BASE_URL=https://de.sentry.io
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
